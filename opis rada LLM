    "pm10": {"min": 6, "avg": 8.6, "max": 11, "p95": 10, "mad": 1.2},
    "temp_c": {"min": 27.6, "avg": 27.6, "max": 27.7},
    "hum_pct": {"min": 19.4, "avg": 19.9, "max": 20.1},
    "ratio_pm25_pm10": 0.97,
