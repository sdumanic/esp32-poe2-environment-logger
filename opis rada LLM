  },
  "flags": [
    {"type": "gap", "at": 1790716207, "detail": "no record for 18 s"},
    {"type": "dht_missing", "at": 1790716210}
  ],
  "series": [[1790716004,6,10,10,27.6,19.8], [1790716012,7,11,11,27.6,19.8], ...],
