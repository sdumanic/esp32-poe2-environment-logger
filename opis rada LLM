             "duration_min": 37, "samples": 61, "gap_max_s": 22},
  "sensor": {"pm": "PMS5003 (1 ug/m3 resolution, 1 Hz)",
             "env": "AM2302/DHT22 (+-0.5 C, +-2 %RH)"},
  "stats": {
